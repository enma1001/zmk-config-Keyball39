#define DEFAULT 0
#define NUM     1
#define FN      2
#define STENO   3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };

        mute_all: mute_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_MUTE &kp K_MUTE>;
            label = "MUTE_ALL";
        };

        vol_up_all: vol_up_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP &kp K_VOLUME_UP>;
            label = "VOL_UP_ALL";
        };

        vol_down_all: vol_down_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_DOWN &kp K_VOLUME_DOWN>;
            label = "VOL_DOWN_ALL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Gallium_Layer {
            label = "GALLIUM";
            bindings = <
&kp Q             &kp X         &kp M    &kp W         &kp Z                            &kp J  &kp F  &kp O      &kp U    &kp BACKSPACE
&kp N             &kp R         &kp T    &kp S         &kp G                            &kp Y  &kp H  &kp A      &kp E    &kp I
&mt LEFT_SHIFT B  &kp L         &kp D    &kp C         &kp V                            &kp K  &kp P  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp TAB  &kp LEFT_ALT  &mo 4  &lt 1 SPACE  &lt 2 ENTER  &mo 4                             &to 4
            >;
        };

        Number_Layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LC(A)     &kp LC(S)     &trans        &kp LC(F)     &kp PG_UP                      &kp HOME      &kp MINUS     &kp EQUAL     &kp LBKT      &kp RBKT
&kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp PAGE_DOWN                  &kp END       &kp GRAVE     &kp APOS      &kp SEMI      &kp BSLH
&trans        &trans        &trans        &trans        &trans         &trans  &trans  &trans                                                  &to 3
            >;
        };

        Function_Layer {
            label = "FN";
            bindings = <
&trans        &trans        &trans        &trans        &bt BT_CLR                    &mute_all      &kp F1  &kp F2   &kp F3   &kp F4
&trans        &trans        &trans        &trans        &trans                        &vol_up_all    &kp F5  &kp F6   &kp F7   &kp F8
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &vol_down_all  &kp F9  &kp F10  &kp F11  &kp F12
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                                   &to 3
            >;
        };

        Stenography_Layer {
            bindings = <
&none   &none   &none   &none   &none                &none  &none  &none  &none  &none
&kp Q   &kp W   &kp E   &kp R   &kp T                &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A   &kp S   &kp D   &kp F   &kp G                &kp H  &kp J  &kp K  &kp L  &kp SEMI
&trans  &trans  &trans  &trans  &kp V  &kp B  &kp N  &kp M                       &to 0
            >;

            label = "STENO";
        };

        Mouse_Layer {
            label = "MOUSE";
            bindings = <
&kp ESCAPE      &trans          &trans          &trans           &kp DELETE                             &trans          &trans     &mkp MCLK  &trans  &trans
&kp CAPSLOCK    &trans          &kp UP_ARROW    &trans           &trans                                 &msc SCRL_UP    &mkp LCLK  &mkp RCLK  &mo 5   &mo 6
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PRINTSCREEN                        &msc SCRL_DOWN  &trans     &trans     &trans  &kp RIGHT_SHIFT
&trans          &trans          &trans          &trans           &trans           &kp SPACE  &kp ENTER  &trans                                        &to 0
            >;
        };

        Scroll_Layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                &trans
            >;
        };

        Snipe_Layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                &trans
            >;
        };
    };
};
