#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Gallium_Layer {
            label = "GALLIUM";
            bindings = <
&kp Q             &kp X         &kp M       &kp W         &kp Z                    &kp J      &kp F  &kp O      &kp U    &kp BACKSPACE
&mt LEFT_SHIFT N  &kp R         &kp T       &kp S         &kp G                    &kp Y      &kp H  &kp A      &kp E    &mt RIGHT_SHIFT I
&kp B             &kp L         &kp D       &kp C         &kp V                    &kp K      &kp P  &kp COMMA  &kp DOT  &kp FSLH
&mt LCTRL TAB     &kp LEFT_WIN  &kp ESCAPE  &kp LEFT_ALT  &kp SPACE  &mo 2  &mo 3  &kp ENTER                             &to 4
            >;
        };

        Stenography_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &trans
&kp Q   &kp W   &kp E   &kp R   &kp T                 &kp Y   &kp U   &kp I   &kp O   &kp P
&kp A   &kp S   &kp D   &kp F   &kp G                 &kp H   &kp J   &kp K   &kp L   &kp SEMI
&trans  &trans  &trans  &trans  &kp V   &kp B  &kp N  &kp M                           &to 0
            >;

            label = "STENO";
        };

        Number_Layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp NUMBER_4  &kp NUMBER_5                   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LC(A)     &kp LC(S)     &kp PRINTSCREEN  &kp LC(F)     &kp PG_UP                      &kp HOME      &kp MINUS     &kp EQUAL     &kp LBKT      &kp RBKT
&kp LC(Z)     &kp LC(X)     &kp LC(C)        &kp LC(V)     &kp PAGE_DOWN                  &kp END       &kp GRAVE     &kp APOS      &kp SEMI      &kp BSLH
&trans        &trans        &trans           &trans        &trans         &trans  &trans  &trans                                                  &trans
            >;
        };

        Function_Layer {
            label = "FN";
            bindings = <
&trans        &trans          &trans        &trans        &bootloader                   &kp K_MUTE    &kp F1  &kp F2   &kp F3   &kp F4
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &kp C_VOL_UP  &kp F5  &kp F6   &kp F7   &kp F8
&bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans                        &kp C_VOL_DN  &kp F9  &kp F10  &kp F11  &kp F12
&trans        &trans          &trans        &trans        &trans        &trans  &trans  &kp DELETE                              &trans
            >;
        };

        Mouse_Layer {
            label = "MOUSE";
            bindings = <
&kp ESCAPE  &kp Q     &kp UP    &kp E         &kp R                    &trans     &trans     &mkp MCLK  &trans  &trans
&kp TAB     &kp LEFT  &kp DOWN  &kp RIGHT     &kp F                    &trans     &mkp LCLK  &mkp RCLK  &mo 5   &trans
&kp LSHIFT  &kp C     &kp L     &kp B         &kp M                    &trans     &trans     &trans     &trans  &trans
&kp LCTRL   &trans    &trans    &kp LEFT_ALT  &kp SPACE  &mo 2  &mo 5  &kp ENTER                                &to 0
            >;
        };

        Scroll_Layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        Snipe_Layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };
    };
};
